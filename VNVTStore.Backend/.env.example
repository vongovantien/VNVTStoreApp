# 🔐 VNVTStore Backend Environment Variables Template
# Copy this file to .env.production and fill in actual values
# NEVER commit .env or .env.production to Git!

# JWT Configuration
JwtSettings__SecretKey=YourSuperSecretJwtKey_MinimumLength32Chars_ChangeInProduction
JwtSettings__Issuer=VNVTStore
JwtSettings__Audience=VNVTStoreUsers

# Database Connection
ConnectionStrings__DefaultConnection=Host=localhost;Database=shoppingdb;Username=postgres;Password=your_password

# Firebase Admin SDK (Base64 encoded JSON key)
# FIREBASE_KEY_BASE64=<base64-encoded-firebase-key-json>

# SMTP Email Settings (if using real SMTP)
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=your-email@gmail.com
EmailSettings__SmtpPassword=your-app-password
EmailSettings__FromEmail=noreply@vnvtstore.com
EmailSettings__FromName=VNVTStore

# VNPay Payment Gateway
VNPay__TmnCode=YOUR_VNPAY_TERMINAL_CODE
VNPay__HashSecret=YOUR_VNPAY_HASH_SECRET

# MoMo Payment Gateway
MoMo__PartnerCode=YOUR_MOMO_PARTNER_CODE
MoMo__AccessKey=YOUR_MOMO_ACCESS_KEY
MoMo__SecretKey=YOUR_MOMO_SECRET_KEY

# Azure Key Vault (if using)
KeyVault__Endpoint=https://your-keyvault.vault.azure.net/

# Redis Cache (if using)
Redis__ConnectionString=localhost:6379

# CORS Allowed Origins (comma-separated)
CorsSettings__AllowedOrigins=https://yourproductiondomain.com,https://www.yourproductiondomain.com
